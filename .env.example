# Core Config
AUTHKIT_SECRET_KEY=sandbox-secret-key-make-it-long-and-secure
AUTHKIT_DATABASE_URL=sqlite+aiosqlite:///./sandbox.db
AUTHKIT_COOKIE_SECURE=False
AUTHKIT_COOKIE_SAMESITE=lax

# SMTP Email Configuration (Fill this out to test real emails)
AUTHKIT_ENABLE_SMTP=False
AUTHKIT_SMTP_HOST=
AUTHKIT_SMTP_PORT=587
AUTHKIT_SMTP_USERNAME=
AUTHKIT_SMTP_PASSWORD=
AUTHKIT_SMTP_FROM_EMAIL=
